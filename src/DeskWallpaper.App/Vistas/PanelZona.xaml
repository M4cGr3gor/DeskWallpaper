<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DeskWallpaper.App.Vistas.PanelZona"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Padding="16" CornerRadius="8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
        <Grid>
            <TextBlock x:Name="SinSeleccion" Text="Selecciona una zona del lienzo"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />

            <StackPanel x:Name="Detalles" Spacing="10" Visibility="Collapsed">
                <TextBlock x:Name="Titulo" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock x:Name="Detalle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

                <StackPanel x:Name="PanelEncuadre" Spacing="6">
                    <TextBlock Text="Encuadre" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE71E;" FontSize="14" VerticalAlignment="Center" />
                        <Slider x:Name="DeslizadorZoom" Grid.Column="1" Minimum="1" Maximum="8" StepFrequency="0.05"
                                ValueChanged="DeslizadorZoom_ValueChanged" />
                        <TextBlock x:Name="TextoZoom" Grid.Column="2" VerticalAlignment="Center" MinWidth="40" />
                    </Grid>
                    <TextBlock Text="Arrastra la imagen en el lienzo para moverla y usa la rueda para el zoom."
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="12" TextWrapping="Wrap" />
                    <Button Content="Centrar" Click="Centrar_Click" />
                </StackPanel>

                <StackPanel x:Name="PanelVideo" Spacing="4" Visibility="Collapsed">
                    <TextBlock Text="Vídeo" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />
                    <ToggleSwitch x:Name="InterruptorReducir" Header="Reducir al tamaño de los monitores"
                                  OnContent="Sí" OffContent="No" Toggled="InterruptorReducir_Toggled" />
                    <TextBlock x:Name="TextoReducir" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               FontSize="12" TextWrapping="Wrap" />
                </StackPanel>

                <InfoBar x:Name="AvisoCalidad" Severity="Warning" IsClosable="False" />

                <StackPanel Spacing="8" Margin="0,8,0,0">
                    <Button x:Name="BotonCambiar" Content="Cambiar imagen…" HorizontalAlignment="Stretch" Click="Cambiar_Click" />
                    <Button x:Name="BotonQuitar" Content="Quitar imagen" HorizontalAlignment="Stretch" Click="Quitar_Click" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
